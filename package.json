{
  "name": "tochniot-bakis",
  "version": "1.0.0",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "pdf": "node scripts/generate-pdfs.mjs",
    "check": "node scripts/check-site.mjs",
    "build:all": "npm run build && npm run pdf && npm run check",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/heebo": "^5.3.0",
    "@fontsource/rubik": "^5.3.0",
    "lucide-react": "^1.77.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "puppeteer-core": "^25.18.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.21"
  },
  "private": true,
  "type": "module"
}
